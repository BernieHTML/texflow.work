node_modules/
.env

# smig's runtime state. These hold real people: email addresses, the 128-float
# face descriptors the unlock gate matches against, private messages, live
# session tokens, and the voice notes and photos themselves. `origin` is a
# GitHub remote, so a stray `git add -A` would publish all of it permanently.
data/smig-*.json
data/smig-media/

# MiniBridge push subscriptions. Each row is a live push endpoint for a real
# person's phone — publishing one would let anyone who found it notify that
# device until they uninstalled the icon.
data/minibridge-push.json

# Local python virtualenv for scripts/.
scripts/.venv/

# MiniBridge build output — ~42MB of generated bundles, wasm and model binaries.
# Source is in /minibridge; `cd minibridge && npm run build` regenerates this
# and is the whole deploy step. Kept out of git the same way Platform66/dist is.
public/minibridge/

# ArthurChat's runtime state: display names, scrypt'd PINs, live session
# tokens and every private message. `origin` is a GitHub remote, so a stray
# `git add -A` would publish all of it permanently.
data/arthurchat-*.json

# BHS Penalty Shootout's runtime state: player email addresses, scrypt'd
# passwords, live session tokens and matches in progress. `origin` is a GitHub
# remote, so a stray `git add -A` would publish all of it permanently.
data/bhs-*.json
