# Database
DATABASE_URL="postgresql://texflow:password@localhost:5432/texflow"

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="generate-secure-secret-here"
JWT_EXPIRES_IN="1h"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend)
RESEND_API_KEY="re_..."

# URLs
NEXT_PUBLIC_APP_URL="https://texflow.work"
NEXT_PUBLIC_API_URL="https://api.texflow.work/v2"
NEXT_PUBLIC_DASHBOARD_URL="https://dashboard.texflow.work"
API_BASE_URL="https://api.texflow.work/v2"

# Features
ENABLE_SIGNUPS=true
ENABLE_AGENT_PURCHASES=true

# Optional monitoring
SENTRY_DSN=""
