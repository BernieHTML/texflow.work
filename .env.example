# Google AI Studio (Gemini) API key for Agent Appeal draft generation (Gemini 1.5 Flash)
# Copy this file to .env and set your key: cp .env.example .env
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here

# Production (VPS): public domain — all canonical/og URLs in the app use https://texflow.work
# Optional; the app uses relative paths so it works on any host. Set if you run behind a different domain.
# PUBLIC_URL=https://texflow.work
