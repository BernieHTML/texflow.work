PORT=3004
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
DATA_DIR=./data

# Optional API keys for channels that support them
NASA_API_KEY=DEMO_KEY
EIA_API_KEY=
NEWSDATA_API_KEY=
FMP_API_KEY=demo
MARINE_TRAFFIC_API_KEY=
FIRMS_API_KEY=

# Polling
DEFAULT_POLL_INTERVAL_MS=60000
ENABLE_POLLING=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
