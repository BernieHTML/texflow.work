PORT=3005
NODE_ENV=development

# TEX shared auth (path relative to texostat/server.js)
TEX_AUTH_MODULE_PATH=../tex/auth/validate.js

# TEX API base URL — used by the bridge to notify SSE subscribers
TEX_BASE_URL=http://localhost:5001

# Public base URL (used in curl commands emitted in feeds)
BASE_URL=https://texflow.work

# Optional API keys (leave blank to disable that channel gracefully)
NASA_KEY=DEMO_KEY
EIA_KEY=
FMP_API_KEY=demo
MARINE_KEY=
NEWSDATA_KEY=

# Polling
ENABLE_POLLING=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
