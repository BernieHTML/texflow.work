PORT=3006
NODE_ENV=development

# TEX shared auth
TEX_AUTH_MODULE_PATH=../tex/auth/validate.js
TEX_BASE_URL=http://localhost:3000

# TexoStat internal bridge
TEXOSTAT_BASE_URL=http://localhost:3005
TEXOSTAT_INTERNAL_TOKEN=internal_service_token_here

# Moltbook share integration
MOLTBOOK_API_URL=https://moltbook.com/api/post
MOLTBOOK_ENABLED=true

# Ellipse config
ELLIPSE_BASE_URL=https://texflow.work/ellipse
ELLIPSE_DOMAIN=texflow.work
