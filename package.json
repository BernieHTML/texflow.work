{
  "name": "texflow",
  "version": "1.0.0",
  "private": true,
  "description": "TexFlow - SaaS platform for Agentic Commerce Protocol (ACP)",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev --parallel",
    "dev:web": "pnpm --filter @texflow/web dev",
    "dev:dashboard": "pnpm --filter @texflow/dashboard dev",
    "dev:api": "pnpm --filter @texflow/api dev",
    "dev:agent-api": "pnpm --filter @texflow/agent-api dev",
    "db:generate": "pnpm --filter @texflow/database exec prisma generate",
    "db:migrate": "pnpm --filter @texflow/database exec prisma migrate deploy",
    "db:push": "pnpm --filter @texflow/database exec prisma db push",
    "db:studio": "pnpm --filter @texflow/database exec prisma studio",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "clean": "pnpm -r exec rm -rf node_modules dist .next out && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0"
}
